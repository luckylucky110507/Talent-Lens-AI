run = "npm run build && python -m uvicorn backend.main:app --host 0.0.0.0 --port ${PORT:-5000}"
entrypoint = "backend/main.py"
modules = ["python-3.12"]

[deployment]
run = ["sh", "-c", "npm run build && python -m uvicorn backend.main:app --host 0.0.0.0 --port ${PORT:-5000}"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run build && python -m uvicorn backend.main:app --host 0.0.0.0 --port 5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[nix]
channel = "stable-25_05"
packages = ["freetype", "glibcLocales", "libxcrypt"]

[agent]
expertMode = true
